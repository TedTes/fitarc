{
  "expo": {
    "name": "fitarc",
    "slug": "fitarc",
    "scheme": "fitarc",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitarc",
      "buildNumber": "6",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Allow Fitarc to access your photos so you can choose a profile picture (e.g., select a photo to use as your avatar)."
      }
    },
    "android": {
      "package": "com.fitarc",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/fitarc-logo-android.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "eb73f024-5eee-4c61-b71f-5270e1f28757"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      "expo-apple-authentication"
    ]
  }
}
